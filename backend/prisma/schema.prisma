generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  major     String
  gpa       Float
  chats     ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // 'user' atau 'assistant'
  content   String   @db.Text
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  createdAt DateTime @default(now())
}